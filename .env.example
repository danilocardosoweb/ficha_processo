NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel
NEXT_PUBLIC_DEFAULT_ORGANIZATION_ID=id-da-organizacao-da-versao-sem-login
# Somente no servidor. Nunca use prefixo NEXT_PUBLIC_ e nunca envie estas chaves ao Git.
# Escolha somente o provedor que será utilizado. As chaves nunca são salvas pela tela.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# LM Studio é local por padrão. O endpoint também pode ser definido na tela, mas só aceita localhost.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=
# OpenClaw deve apontar para um servidor HTTPS aprovado pela empresa.
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=
APP_URL=http://localhost:3000

# Somente para desenvolvimento local quando o Supabase estiver indisponível.
# Nunca habilite em produção e remova após a recuperação do projeto.
LOCAL_DEV_AUTH_ENABLED=false
LOCAL_DEV_AUTH_LOGIN=dev
LOCAL_DEV_AUTH_PASSWORD=troque-esta-senha-local
LOCAL_DEV_AUTH_TOKEN=gere-um-token-local-longo
